+#define EXYNOS_G3D_SYSREG_PA            0x16c00000ULL
+#define EXYNOS_CMU_G3D_QCH_PA           0x16c20000ULL
+#define EXYNOS_CMU_G3D_PA               0x16c30000ULL
+#define EXYNOS_G3D_DUMP_PA              0x16c60000ULL
+#define EXYNOS_G3D_STR_MUX_PA           0x16c80000ULL
+#define EXYNOS_BG3D_PWRCTL_PA           0x16cd0000ULL
+#define EXYNOS_SGPU_SMN_PA              0x16e00000ULL
+#define EXYNOS_DPP0_DMA_PA              0x1ad00000ULL
+#define EXYNOS_DECON0_MAIN_PA           0x19f00000ULL
