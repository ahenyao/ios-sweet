+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setName("IOAcceleratorES");
+	setProperty(kIOUserClientClassKey, "SweetAcceleratorUserClient");
+	setProperty("IOClass", "IOAcceleratorES");
+	setProperty("IOMatchCategory", "IOAcceleratorES");
+	setProperty("MetalPluginName", "AGXMetalA11");
+	setProperty("MetalPluginClassName", "AGXPrincipalDevice");
+	registerService();
+	IOLog("SWEET GPU: IOAcceleratorES service registered\n");
+	return true;
+}
+
+IOReturn
+IOAcceleratorES::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    __unused OSDictionary *properties, IOUserClient **handler)
+{
+	SweetAcceleratorUserClient *client = OSTypeAlloc(SweetAcceleratorUserClient);
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type) ||
+	    !client->attach(this) ||
+	    !client->start(this)) {
+		client->release();
+		return kIOReturnError;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+bool
+SweetAcceleratorUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fType = type;
+	fSharedMem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, page_size, page_size);
+	if (fSharedMem != NULL) {
+		bzero(fSharedMem->getBytesNoCopy(), page_size);
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET GPU: %s opened IOAcceleratorES user client (type %u)\n", name, (uint32_t)type);
+	return true;
+}
+
+void
+SweetAcceleratorUserClient::free()
+{
+	OSSafeReleaseNULL(fSharedMem);
+	IOUserClient::free();
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET GPU: %s clientMemoryForType(%u)\n", name, (uint32_t)type);
+	if (fSharedMem == NULL) {
+		return kIOReturnNoMemory;
+	}
+	fSharedMem->retain();
+	*options = 0;
+	*memory = fSharedMem;
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_gpu_sel_logged;
+
+IOReturn
+SweetAcceleratorUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	if (selector >= 64 || !(sweet_gpu_sel_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_gpu_sel_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET GPU: %s type %u sel %u in %u/%u out %u/%u\n",
+		    name, (uint32_t)fType, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
