+/*
+ * Fast 64-byte write-combining burst copy for Normal-NC / Write-Combine memory.
+ */
+static inline void
+sweet_fb_fast_copy(void *dst, const void *src, size_t nbytes)
+{
+	uint64_t *d = (uint64_t *)dst;
+	const uint64_t *s = (const uint64_t *)src;
+	size_t n64 = nbytes >> 6;
+	while (n64--) {
+		uint64_t v0 = s[0], v1 = s[1], v2 = s[2], v3 = s[3];
+		uint64_t v4 = s[4], v5 = s[5], v6 = s[6], v7 = s[7];
+		d[0] = v0; d[1] = v1; d[2] = v2; d[3] = v3;
+		d[4] = v4; d[5] = v5; d[6] = v6; d[7] = v7;
+		s += 8;
+		d += 8;
+	}
+	size_t rem8 = (nbytes & 63) >> 3;
+	while (rem8--) {
+		*d++ = *s++;
+	}
+	if (nbytes & 4) {
+		*(uint32_t *)d = *(const uint32_t *)s;
+	}
+}
+
+/*
+ * Convert a row of 10-bit RGB10A2 ('w30r' = 0x77333072) pixels to 8-bit BGRA8888.
+ */
+static inline void
+sweet_fb_copy_w30r_row(uint32_t *dst, const uint32_t *src, uint32_t count)
+{
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t p = src[i];
+		uint32_t r = (p >> 22) & 0xff;
+		uint32_t g = (p >> 12) & 0xff;
+		uint32_t b = (p >> 2)  & 0xff;
+		dst[i] = 0xff000000U | (r << 16) | (g << 8) | b;
+	}
+}
