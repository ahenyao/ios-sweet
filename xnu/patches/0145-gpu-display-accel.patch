+static void
+exynos_gpu_probe(IOService *provider)
+{
+	int gpu_mode = 1;
+	PE_parse_boot_argn("sweetgpu", &gpu_mode, sizeof(gpu_mode));
+	if (gpu_mode == 0) {
+		return;
+	}
+
+	g_dpp0_dma_va = ml_io_map(EXYNOS_DPP0_DMA_PA, 0x1000);
+	g_decon0_va   = ml_io_map(EXYNOS_DECON0_MAIN_PA, 0x1000);
+
+	g_pmu_va = ml_io_map(EXYNOS_PMU_BASE_PA, EXYNOS_PMU_MAP_SIZE);
+
+	if (provider != NULL) {
+		AGXAccelerator *accel = OSTypeAlloc(AGXAccelerator);
+		if (accel != NULL) {
+			if (!accel->init() || !accel->attach(provider) || !accel->start(provider)) {
+				accel->release();
+			}
+		}
+	}
+}
