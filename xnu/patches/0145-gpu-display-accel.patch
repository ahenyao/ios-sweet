+/*
+ * Exynos 2200 (s5e9925 / g0s) G3D (Xclipse 920 / sgpu) & DECON/DPP probe
+ * and IOAcceleratorES service stub.
+ */
+#define EXYNOS_PMU_DPUF_PA      0x15862100ULL
+#define EXYNOS_PMU_G3DCORE_PA   0x15862280ULL
+#define EXYNOS_SGPU_BASE_PA     0x16c00000ULL
+#define EXYNOS_SGPU_PM_PA       0x16cd0000ULL
+#define EXYNOS_SGPU_SMN_PA      0x16e00000ULL
+#define EXYNOS_SGPU_DOORBELL_PA 0x16f00000ULL
+#define EXYNOS_SGPU_RMEM_PA     0x8ff00000ULL
+#define EXYNOS_DECON0_MAIN_PA   0x19f00000ULL
+#define EXYNOS_DPP0_DMA_PA      0x1ad00000ULL
+
+static inline uint32_t
+exynos_mmio_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+exynos_mmio_wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+exynos_gpu_probe(void)
+{
+	int gpu_mode = 1;
+	PE_parse_boot_argn("sweetgpu", &gpu_mode, sizeof(gpu_mode));
+	if (gpu_mode == 0) {
+		IOLog("SWEET GPU: disabled via sweetgpu=0\n");
+		return;
+	}
+
+	/* Map PMU page containing pd_dpuf (0x15862100) and pd_g3dcore (0x15862280) */
+	vm_offset_t pmu_page = ml_io_map(0x15860000ULL, 0x4000);
+	if (pmu_page == 0) {
+		IOLog("SWEET GPU: failed to map PMU page 0x15860000\n");
+		return;
+	}
+
+	uint32_t dpuf_cfg  = exynos_mmio_rd32(pmu_page, 0x2100 + 0x00);
+	uint32_t dpuf_stat = exynos_mmio_rd32(pmu_page, 0x2100 + 0x04);
+	uint32_t g3d_cfg   = exynos_mmio_rd32(pmu_page, 0x2280 + 0x00);
+	uint32_t g3d_stat  = exynos_mmio_rd32(pmu_page, 0x2280 + 0x04);
+
+	IOLog("SWEET GPU: PMU pd_dpuf cfg=0x%x stat=0x%x | pd_g3dcore cfg=0x%x stat=0x%x\n",
+	    dpuf_cfg, dpuf_stat, g3d_cfg, g3d_stat);
+
+	/* If pd_g3dcore is off, try enabling local power configuration */
+	if ((g3d_stat & 0x7) == 0) {
+		exynos_mmio_wr32(pmu_page, 0x2280 + 0x00, 0x7);
+		for (int i = 0; i < 10000; i++) {
+			g3d_stat = exynos_mmio_rd32(pmu_page, 0x2280 + 0x04);
+			if ((g3d_stat & 0x7) != 0) {
+				break;
+			}
+		}
+		IOLog("SWEET GPU: after PMU kick pd_g3dcore cfg=0x%x stat=0x%x\n",
+		    exynos_mmio_rd32(pmu_page, 0x2280 + 0x00), g3d_stat);
+	}
+
+	/* Probe DPP0 DMA (since pd_dpuf is boot-on) to find the 0xf6200000 scanout pointer */
+	vm_offset_t dpp0_dma = ml_io_map(EXYNOS_DPP0_DMA_PA, 0x4000);
+	if (dpp0_dma != 0) {
+		IOLog("SWEET GPU: DPP0 DMA[0x0..0x1c]: %08x %08x %08x %08x\n",
+		    exynos_mmio_rd32(dpp0_dma, 0x00),
+		    exynos_mmio_rd32(dpp0_dma, 0x04),
+		    exynos_mmio_rd32(dpp0_dma, 0x08),
+		    exynos_mmio_rd32(dpp0_dma, 0x0c));
+		for (uint32_t off = 0; off < 0x1000; off += 4) {
+			uint32_t v = exynos_mmio_rd32(dpp0_dma, off);
+			if (v == 0xf6200000U) {
+				IOLog("SWEET GPU: found FB base 0xf6200000 in DPP0_DMA+0x%x!\n", off);
+			}
+		}
+	}
+
+	/* Only touch SGPU MMIO if pd_g3dcore reports powered on */
+	if ((g3d_stat & 0x7) != 0) {
+		vm_offset_t sgpu_pm  = ml_io_map(EXYNOS_SGPU_PM_PA, 0x10000);
+		vm_offset_t sgpu_smn = ml_io_map(EXYNOS_SGPU_SMN_PA, 0x100000);
+		if (sgpu_pm != 0 && sgpu_smn != 0) {
+			uint32_t pm0 = exynos_mmio_rd32(sgpu_pm, 0x00);
+			uint32_t grbm_status = exynos_mmio_rd32(sgpu_smn, 0x8010);
+			IOLog("SWEET GPU: Xclipse 920 active! pm0=0x%x GRBM_STATUS=0x%x\n",
+			    pm0, grbm_status);
+		}
+	} else {
+		IOLog("SWEET GPU: pd_g3dcore still gated (stat=0x%x); skipping SGPU MMIO read to avoid bus abort\n",
+		    g3d_stat);
+	}
+}
