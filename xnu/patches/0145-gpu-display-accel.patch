+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "SweetAcceleratorUserClient");
+	setProperty("IOClass", "IOAcceleratorES");
+	registerService();
+	IOLog("SWEET GPU: IOAcceleratorES service registered\n");
+	return true;
+}
+
+bool
+SweetAcceleratorUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET GPU: %s opened IOAcceleratorES user client (type %u)\n", name, (uint32_t)type);
+	return true;
+}
+
+IOReturn
+SweetAcceleratorUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_gpu_sel_logged;
+
+IOReturn
+SweetAcceleratorUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	if (selector >= 64 || !(sweet_gpu_sel_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_gpu_sel_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET GPU: %s sel %u in %u/%u out %u/%u\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnUnsupported;
+}
+
+static void
+exynos_gpu_probe(IOService *provider)
+{
+	int gpu_mode = 1;
+	PE_parse_boot_argn("sweetgpu", &gpu_mode, sizeof(gpu_mode));
+	if (gpu_mode == 0) {
+		IOLog("SWEET GPU: disabled via sweetgpu=0\n");
+		return;
+	}
+
+	/* Map DPP0 DMA (0x1ad00000) and DECON0_MAIN (0x19f00000) */
+	g_dpp0_dma_va = ml_io_map(EXYNOS_DPP0_DMA_PA, 0x1000);
+	g_decon0_va   = ml_io_map(EXYNOS_DECON0_MAIN_PA, 0x1000);
+	if (g_dpp0_dma_va != 0) {
+		uint32_t base_y8 = exynos_mmio_rd32(g_dpp0_dma_va, 0x040);
+		uint32_t shd_y8  = exynos_mmio_rd32(g_dpp0_dma_va, 0x440);
+		IOLog("SWEET GPU: DPP0_DMA ready: IDMA_BASE=0x%08x SHADOW=0x%08x\n",
+		    base_y8, shd_y8);
+	}
+
+	/* Read-only check of PMU status (never touch unclocked SGPU MMIO!) */
+	vm_offset_t pmu_page = ml_io_map(EXYNOS_PMU_BASE_PA, 0x4000);
+	if (pmu_page != 0) {
+		uint32_t dpuf_stat = exynos_mmio_rd32(pmu_page, 0x2100 + 0x04);
+		uint32_t g3d_stat  = exynos_mmio_rd32(pmu_page, 0x2280 + 0x04);
+		IOLog("SWEET GPU: PMU read-only stat: pd_dpuf=0x%x pd_g3dcore=0x%x\n",
+		    dpuf_stat, g3d_stat);
+	}
+
+	/* Only publish IOAcceleratorES stub when sweetgpu=2 is passed */
+	if (gpu_mode >= 2 && provider != NULL) {
+		IOAcceleratorES *accel = OSTypeAlloc(IOAcceleratorES);
+		if (accel != NULL) {
+			if (!accel->init() || !accel->attach(provider) || !accel->start(provider)) {
+				accel->release();
+			}
+		}
+	}
+}
 
