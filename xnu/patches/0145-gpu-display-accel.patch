+/*
+ * Safe G3D bring-up called after UFS persistent logging (SWEET LOG) is active.
+ * Do NOT write 0x3ef0 (V_PWREN) non-atomically, as that clears active PMIC rails.
+ */
+static void
+exynos_g3dcore_late_init(void)
+{
+	int gpu_mode = 1;
+	PE_parse_boot_argn("sweetgpu", &gpu_mode, sizeof(gpu_mode));
+	if (gpu_mode < 2 || g_pmu_va == 0) {
+		return;
+	}
+
+	IOLog("SWEET GPU: starting late G3DCORE power-up (VGPIO_MON=0x%x)...\n",
+	    exynos_mmio_rd32(g_pmu_va, 0x0a10));
+
+	/* 1. Enable G3DCORE_CONFIGURATION (0x15862280) = 1 and wait for G3DCORE_STATUS (0x15862284) */
+	exynos_mmio_wr32(g_pmu_va, 0x2280, 0x1);
+	for (int i = 0; i < 20000; i++) {
+		if (exynos_mmio_rd32(g_pmu_va, 0x2284) & 0x1) {
+			break;
+		}
+		IODelay(1);
+	}
+
+	uint32_t g3d_stat = exynos_mmio_rd32(g_pmu_va, 0x2284);
+	IOLog("SWEET GPU: G3DCORE_STATUS=0x%x after PMU enable\n", g3d_stat);
+	if ((g3d_stat & 0x1) == 0) {
+		return;
+	}
+
+	/* 2. Unlock TrustZone DTZPC for G3DCORE (need_smc = 0x16c10204) */
+	uint64_t smc_a1 = 0;
+	uint64_t smc_rc = exynos_smc(SMC_CMD_PREAPRE_PD_ONOFF,
+	    EXYNOS_WAKEUP_PD_DOWN, G3DCORE_NEED_SMC_ID, RUNTIME_PM_TZPC_GROUP, &smc_a1);
+	IOLog("SWEET GPU: DTZPC SMC(0x82000410) rc=0x%llx a1=0x%llx\n", smc_rc, smc_a1);
+
+	/* 3. Map and check BG3D_PWRCTL (0x16cd0000) */
+	vm_offset_t pwrctl_va = ml_io_map(EXYNOS_BG3D_PWRCTL_PA, 0x1000);
+	vm_offset_t cmu_va    = ml_io_map(EXYNOS_CMU_G3D_PA, 0x4000);
+	if (pwrctl_va == 0 || cmu_va == 0) {
+		IOLog("SWEET GPU: failed to map BG3D_PWRCTL / CMU_G3D\n");
+		return;
+	}
+
+	uint32_t ctl2_orig = exynos_mmio_rd32(pwrctl_va, BG3D_PWRCTL_CTL2_OFFSET);
+	uint32_t stat_orig = exynos_mmio_rd32(pwrctl_va, BG3D_PWRCTL_STATUS_OFFSET);
+	IOLog("SWEET GPU: BG3D_PWRCTL initial CTL2=0x%x STATUS=0x%x\n", ctl2_orig, stat_orig);
+
+	exynos_mmio_wr32(pwrctl_va, BG3D_PWRCTL_CTL2_OFFSET, 0x2a);
+	uint32_t pwr_status = 0;
+	for (int i = 0; i < 50000; i++) {
+		pwr_status = exynos_mmio_rd32(pwrctl_va, BG3D_PWRCTL_STATUS_OFFSET);
+		if (pwr_status & BG3D_PWRCTL_STATUS_GPU_READY) {
+			break;
+		}
+		IODelay(1);
+	}
+	exynos_mmio_rmw32(cmu_va, 0x0860, 0x1, 0x1);
+	IOLog("SWEET GPU: BG3D_PWRCTL after GPUPWRREQ STATUS=0x%08x\n", pwr_status);
+
+	if (pwr_status & BG3D_PWRCTL_STATUS_GPU_READY) {
+		vm_offset_t sgpu_smn = ml_io_map(EXYNOS_SGPU_SMN_PA, 0x100000);
+		if (sgpu_smn != 0) {
+			g_sgpu_grbm_status = exynos_mmio_rd32(sgpu_smn, 0x8010);
+			g_sgpu_powered = true;
+			IOLog("SWEET GPU: Xclipse 920 awake! GRBM_STATUS=0x%08x\n", g_sgpu_grbm_status);
+		}
+	}
+}
