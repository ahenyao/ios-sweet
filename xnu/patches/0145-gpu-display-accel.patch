+static void
+exynos_g3dcore_late_init(void)
+{
+	int gpu_mode = 1;
+	PE_parse_boot_argn("sweetgpu", &gpu_mode, sizeof(gpu_mode));
+	if (gpu_mode < 2 || g_pmu_va == 0) {
+		return;
+	}
+
+	exynos_pmu_set_bit_atomic(g_pmu_va, 0x3ef0, 0xa);
+	for (int i = 0; i < 50000; i++) {
+		if (exynos_mmio_rd32(g_pmu_va, 0x0a10) & (1U << 7)) {
+			break;
+		}
+		IODelay(1);
+	}
+	IODelay(100);
+
+	exynos_mmio_rmw32(g_pmu_va, 0x2280, 0x1, 0x1);
+	for (int i = 0; i < 50000; i++) {
+		if (exynos_mmio_rd32(g_pmu_va, 0x2284) & 0x1) {
+			break;
+		}
+		IODelay(1);
+	}
+
+	uint32_t g3d_stat = exynos_mmio_rd32(g_pmu_va, 0x2284);
+	if ((g3d_stat & 0x1) == 0) {
+		return;
+	}
+
+	uint64_t smc_a1 = 0;
+	exynos_smc(SMC_CMD_PREAPRE_PD_ONOFF, EXYNOS_WAKEUP_PD_DOWN,
+	    G3DCORE_NEED_SMC_ID, RUNTIME_PM_TZPC_GROUP, &smc_a1);
+
+	vm_offset_t pwrctl_va = ml_io_map(EXYNOS_BG3D_PWRCTL_PA, 0x1000);
+	vm_offset_t cmu_va    = ml_io_map(EXYNOS_CMU_G3D_PA, 0x4000);
+	vm_offset_t dump_va   = ml_io_map(EXYNOS_G3D_DUMP_PA, 0x1000);
+	vm_offset_t strmux_va = ml_io_map(EXYNOS_G3D_STR_MUX_PA, 0x1000);
+	vm_offset_t sysreg_va = ml_io_map(EXYNOS_G3D_SYSREG_PA, 0x1000);
+	if (pwrctl_va == 0 || cmu_va == 0) {
+		return;
+	}
+
+	uint32_t ctl2_orig = exynos_mmio_rd32(pwrctl_va, BG3D_PWRCTL_CTL2_OFFSET);
+	if ((ctl2_orig & (1U << 5)) == 0) {
+		exynos_mmio_rmw32(pwrctl_va, BG3D_PWRCTL_CTL2_OFFSET, 0x3f, 0x12);
+	} else {
+		exynos_mmio_rmw32(pwrctl_va, BG3D_PWRCTL_CTL2_OFFSET, 0x3f, 0x2a);
+	}
+
+	if (dump_va != 0) {
+		exynos_mmio_rmw32(dump_va, 0x0700, 0x1, 0x1);
+	}
+	if (strmux_va != 0) {
+		exynos_mmio_rmw32(strmux_va, 0x0000, 0x1, 0x1);
+	}
+	exynos_mmio_rmw32(cmu_va, 0x0860, 0x1, 0x1);
+
+	exynos_pmu_set_bit_atomic(g_pmu_va, 0x3c14, 0x7);
+	for (int i = 0; i < 50000; i++) {
+		if ((exynos_mmio_rd32(g_pmu_va, 0x3c14) & (1U << 7)) == 0) {
+			break;
+		}
+		IODelay(1);
+	}
+	if (dump_va != 0) {
+		exynos_mmio_rmw32(dump_va, 0x0700, 0x1, 0x1);
+	}
+	if (sysreg_va != 0) {
+		exynos_mmio_wr32(sysreg_va, 0x0008, 0x6);
+	}
+
+	/* FIXED: Assert 0x2a to keep GPUPWRREQ (bit 1) and COLDVSGFXOFF asserted simultaneously */
+	exynos_mmio_wr32(pwrctl_va, BG3D_PWRCTL_CTL2_OFFSET, 0x2a);
+	uint32_t pwr_status = 0;
+	for (int i = 0; i < 50000; i++) {
+		pwr_status = exynos_mmio_rd32(pwrctl_va, BG3D_PWRCTL_STATUS_OFFSET);
+		if (pwr_status & BG3D_PWRCTL_STATUS_GPU_READY) {
+			break;
+		}
+		IODelay(1);
+	}
+
+	IOLog("SWEET GPU: BG3D_PWRCTL final STATUS=0x%08x READY=%u\n",
+	    pwr_status, (pwr_status & BG3D_PWRCTL_STATUS_GPU_READY) ? 1 : 0);
+
+	if (pwr_status & BG3D_PWRCTL_STATUS_GPU_READY) {
+		vm_offset_t sgpu_smn = ml_io_map(EXYNOS_SGPU_SMN_PA, 0x100000);
+		if (sgpu_smn != 0) {
+			g_sgpu_grbm_status = exynos_mmio_rd32(sgpu_smn, 0x8010);
+			g_sgpu_powered = true;
+			IOLog("SWEET GPU: Xclipse 920 awake! GRBM_STATUS=0x%08x\n", g_sgpu_grbm_status);
+		}
+	}
+}
