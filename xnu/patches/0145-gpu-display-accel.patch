+static inline uint32_t
+exynos_mmio_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+exynos_mmio_wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static inline void
+exynos_mmio_rmw32(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t val)
+{
+	uint32_t cur = exynos_mmio_rd32(base, off);
+	exynos_mmio_wr32(base, off, (cur & ~mask) | (val & mask));
+}
+
+static inline void
+exynos_pmu_set_bit_atomic(vm_offset_t pmu_base, uint32_t offset, uint32_t bit_idx)
+{
+	if (offset <= 0x3fff) {
+		exynos_mmio_wr32(pmu_base, offset | 0xc000U, bit_idx);
+	}
+}
+
+static uint64_t
+exynos_smc(uint64_t cmd, uint64_t arg1, uint64_t arg2, uint64_t arg3, uint64_t *out_a1)
+{
+	register uint64_t x0 __asm__("x0") = cmd;
+	register uint64_t x1 __asm__("x1") = arg1;
+	register uint64_t x2 __asm__("x2") = arg2;
+	register uint64_t x3 __asm__("x3") = arg3;
+	__asm__ volatile(
+		"dsb sy\n\t"
+		"smc #0\n\t"
+		: "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+		:
+		: "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+		  "x12", "x13", "x14", "x15", "x16", "x17", "memory"
+	);
+	if (out_a1 != NULL) {
+		*out_a1 = x1;
+	}
+	return x0;
+}
+
+static inline void
+sweet_fb_fast_copy(void *dst, const void *src, size_t nbytes)
+{
+	uint64_t *d = (uint64_t *)dst;
+	const uint64_t *s = (const uint64_t *)src;
+	size_t n64 = nbytes >> 6;
+	while (n64--) {
+		uint64_t v0 = s[0], v1 = s[1], v2 = s[2], v3 = s[3];
+		uint64_t v4 = s[4], v5 = s[5], v6 = s[6], v7 = s[7];
+		d[0] = v0; d[1] = v1; d[2] = v2; d[3] = v3;
+		d[4] = v4; d[5] = v5; d[6] = v6; d[7] = v7;
+		s += 8;
+		d += 8;
+	}
+	size_t rem8 = (nbytes & 63) >> 3;
+	while (rem8--) {
+		*d++ = *s++;
+	}
+	if (nbytes & 4) {
+		*(uint32_t *)d = *(const uint32_t *)s;
+	}
+}
+
+static inline void
+sweet_fb_copy_w30r_row(uint32_t *dst, const uint32_t *src, uint32_t count)
+{
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t p = src[i];
+		uint32_t r = (p >> 22) & 0xff;
+		uint32_t g = (p >> 12) & 0xff;
+		uint32_t b = (p >> 2)  & 0xff;
+		dst[i] = 0xff000000U | (r << 16) | (g << 8) | b;
+	}
+}
