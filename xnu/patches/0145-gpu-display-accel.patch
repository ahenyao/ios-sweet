+/*
+ * Exynos 2200 (s5e9925 / g0s) Display DMA (DPP0 / DECON0) & G3D probe.
+ * Confirmed on hardware:
+ *   DPP0_DMA (0x1ad00000) + 0x040 = IDMA_BASE_ADDR_Y8_0 (0xf6200000)
+ *   DPP0_DMA (0x1ad00000) + 0x440 = IDMA_BASE_ADDR_Y8_0_S (shadow, 0xf6200000)
+ *
+ * NOTE: Do NOT kick pd_g3dcore (0x15862280) or read SGPU MMIO (0x16cd0000 /
+ * 0x16e00000) until CMU_G3D clocks and TZMP SMC (0x16c10204) are initialized,
+ * otherwise reading unclocked SGPU registers triggers an AXI SError panic!
+ */
+#define EXYNOS_PMU_BASE_PA      0x15860000ULL
+#define EXYNOS_DPP0_DMA_PA      0x1ad00000ULL
+#define EXYNOS_DECON0_MAIN_PA   0x19f00000ULL
+
+static vm_offset_t g_dpp0_dma_va;
+static vm_offset_t g_decon0_va;
+
+static inline uint32_t
+exynos_mmio_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+exynos_mmio_wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Fast 64-byte write-combining burst copy for Normal-NC / Write-Combine memory.
+ */
+static inline void
+sweet_fb_fast_copy(void *dst, const void *src, size_t nbytes)
+{
+	uint64_t *d = (uint64_t *)dst;
+	const uint64_t *s = (const uint64_t *)src;
+	size_t n64 = nbytes >> 6;
+	while (n64--) {
+		uint64_t v0 = s[0], v1 = s[1], v2 = s[2], v3 = s[3];
+		uint64_t v4 = s[4], v5 = s[5], v6 = s[6], v7 = s[7];
+		d[0] = v0; d[1] = v1; d[2] = v2; d[3] = v3;
+		d[4] = v4; d[5] = v5; d[6] = v6; d[7] = v7;
+		s += 8;
+		d += 8;
+	}
+	size_t rem8 = (nbytes & 63) >> 3;
+	while (rem8--) {
+		*d++ = *s++;
+	}
+	if (nbytes & 4) {
+		*(uint32_t *)d = *(const uint32_t *)s;
+	}
+}
