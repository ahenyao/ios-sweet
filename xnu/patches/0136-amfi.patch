+/*
+ * Policy "SWEET AMFI": Userland daemons (like lsd and pkd via libmis) 
+ * will invoke mac_syscall("AMFI", ...) to query trust cache status 
+ * or validate cdhashes. We unconditionally approve them.
+ */
+static int
+sweet_amfi_syscall(struct proc *p, int call, __unused user_addr_t arg)
+{
+    char name[32];
+    proc_name(proc_pid(p), name, sizeof(name));
+    
+    /* Log occasional AMFI syscalls from lsd/pkd to track progress */
+    if (strncmp(name, "lsd", 3) == 0 || strncmp(name, "pkd", 3) == 0) {
+        printf("SWEET AMFI: %s[%d] allowed mac_syscall op %d\n", name, proc_pid(p), call);
+    }
+    
+    return 0; /* Unconditionally trusted */
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
-	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+    .mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+    .mpo_policy_syscall = sweet_amfi_syscall,
 };
 
