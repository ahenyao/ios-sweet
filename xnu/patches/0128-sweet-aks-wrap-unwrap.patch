+/* Copy input structure (inband or descriptor) into buf. */
+static IOReturn
+sweet_aks_struct_in(IOExternalMethodArguments *args, void *buf, uint32_t max_len, uint32_t *out_len)
+{
+	uint32_t len = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	if (len > max_len) {
+		return kIOReturnNoSpace;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		args->structureInputDescriptor->readBytes(0, buf, len);
+	} else if (args->structureInput != NULL && len > 0) {
+		memcpy(buf, args->structureInput, len);
+	} else if (len > 0) {
+		return kIOReturnBadArgument;
+	}
+	*out_len = len;
+	return kIOReturnSuccess;
+}
